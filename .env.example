# Copy this file to ".env" and fill in your values, then run ./run_live.sh
# (.env is gitignored — your secrets never leave the Mac.)

# --- which real market to stream live bid/ask from -----------------------
# bybit is deep-liquidity, tight-spread and UK-accessible. Alternatives that
# also work with ccxt.pro: kraken, okx, coinbase, kucoin.
EXCHANGE=bybit

# --- Telegram phone notifications (free) ---------------------------------
# 1) message @BotFather -> /newbot -> copy the token
# 2) message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat id
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# --- cloud sync so the hosted dashboard sees your Mac's fills ------------
# GITHUB_TOKEN: a token with ONLY the "gist" scope (github.com/settings/tokens)
# GIST_ID:      create once with:  GITHUB_TOKEN=... python cloud_sync.py
GITHUB_TOKEN=
GIST_ID=
